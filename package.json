{
  "name": "folder-browser",
  "private": true,
  "version": "0.1.2",
  "description": "Folder and ZIP browser and editor, with a viewer for WSNP (.wsnp) web page snapshots",
  "author": "Anderson Santos",
  "license": "MPL-2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:electron": "vite build -c vite.electron.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint core electron e2e src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "package:linux": "npm run build && electron-builder --linux deb rpm --publish never",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "build:ui": "vite build",
    "build": "npm run build:ui && npm run build:docs && npm run build:electron",
    "app": "npm run build && electron .",
    "package:smoke": "node scripts/package-smoke.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "screenshots": "npm run build && node scripts/screenshots.ts",
    "build:docs": "vite build -c vite.docs.config.ts --mode docx && vite build -c vite.docs.config.ts --mode pptx && vite build -c vite.docs.config.ts --mode odf"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.3.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@opendocument/odr-core": "^7.4.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-beautify": "^1.14.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "allotment": "^1.20.5",
    "docx-preview": "^0.4.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "js-beautify": "^2.0.3",
    "markdown-it": "^15.0.2",
    "oxlint": "^1.86.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "homepage": "https://github.com/asantos43/folder-browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asantos43/folder-browser.git"
  },
  "build": {
    "appId": "io.github.asantos43.folder-browser",
    "productName": "Folder Browser",
    "copyright": "Copyright (c) 2026 Anderson Santos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "artifactName": "folder-browser-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Utility",
      "maintainer": "Folder Browser <noreply@github.com>",
      "synopsis": "Folder and ZIP browser and editor, with a WSNP viewer",
      "mimeTypes": [
        "application/vnd.wsnp+zip",
        "application/zip",
        "inode/directory"
      ],
      "executableName": "folder-browser",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": "wsnp",
        "name": "WSNP snapshot",
        "description": "WSNP snapshot (a saved web page)",
          "role": "Viewer",
        "isPackage": false
      }
    ],
    "deb": {
      "fpm": [
        "build/linux/folder-browser.xml=/usr/share/mime/packages/folder-browser.xml"
      ]
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none",
        "build/linux/folder-browser.xml=/usr/share/mime/packages/folder-browser.xml"
      ]
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.md"
      }
    ]
  },
  "desktopName": "folder-browser.desktop",
  "dependencies": {
    "sql.js": "^1.14.2"
  }
}
