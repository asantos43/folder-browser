{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"], "@core/*": ["./core/*"] },
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["core", "electron", "export", "e2e", "src", "*.config.ts"]
}
