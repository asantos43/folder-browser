        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "(?=[\\s\\S]*\\S)(?:^[^\\u0000]+$)"
        },
        "key": {
          "type": "string",
          "pattern": "^ed25519:[a-fA-F0-9]{64}$"
        }
      },
      "required": [
        "id",
        "name"
