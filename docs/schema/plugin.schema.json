              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "(?=[\\s\\S]*\\S)(?:^[^\\u0000]+$)"
              },
              "keys": {
                "type": "string",
                "minLength": 1,
