{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folder-browser.local/schema/plugin.schema.json",
  "title": "Folder Browser plugin manifest (schema 1)",
  "$comment": "The runtime additionally enforces UTF-8 byte limits, 256 KB serialized size, depth 8, 20,000 nodes, descriptor/prototype safety, owned namespaces, unique contribution ids, activation references, defaults within declared bounds, and enum label counts. Those cross-field/data-model constraints are not expressible in portable JSON Schema 2020-12. Strings are plain text. No user-provided regex patterns are accepted.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
