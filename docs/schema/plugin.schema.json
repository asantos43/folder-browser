          "maxItems": 100
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "(?=[\\s\\S]*\\S)(?:^(?!(?:constructor|prototype)$)[a-z][a-z0-9-]{0,63}$)"
              },
              "label": {
                "type": "string",
                "minLength": 1,
